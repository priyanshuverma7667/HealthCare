
@{
    ViewBag.Title = "ManageEnquiry";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

@using HealthCare_ProtoType.Models
@model List<enquirymaster>

<h1 class="text-center bg-danger text-light">Doctor List</h1>
<div class="row p-5" style="min-height:400px;">
    @*<div class="col-sm-10">*@
    <div class="card">
        <div class="table-responsive">
            <table class="table-striped table-hover table">
                <thead class="table-success">
                    <tr>
                        <th>S.N.</th>
                        <th>User Name</th>
                        <th>Email</th>
                        <th>Mobile Number</th>
                        <th>Message</th>
                        <th>Enquiry Date & times</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sn = 1;
                    }

                    @foreach (enquirymaster dm in Model)
                    {
                        <tr>
                            <td>@sn</td>
                            <td>@dm.Name</td>
                            <td>@dm.Email</td>
                            <td>@dm.Mobile</td>
                            <td>@dm.Message</td>
                            <td>@dm.EnquiryDT</td>
                            <td>
                                <a href="#" class="btn btn-primary btn-sm">
                                    <i class="bi bi-pen"></i> Update
                                </a>

                                <a href="/Admin/DeleteEnquiry?id=@dm.EnquiryId" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this doctor?');">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>

                        sn++;
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

