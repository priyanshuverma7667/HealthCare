
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

<div class="container py-5">
    <div class="row gap-4">

        <!--Start card 1-->
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">Appointment Status</h5>
                <p class="card-text text-center">
                    <!--Icons-->
                    <i class="bi bi-house fs-1"></i>
                </p>
                <p class="text-end">
                    <a href="/Admin/Index" class="btn btn-primary">Go</a>
                </p>
            </div>
        </div>
        <!--Start card 2-->
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">Add Notification</h5>
                <p class="card-text text-center">
                    <!--Icons-->
                    <i class="bi bi-bell-fill fs-1"></i>
                </p>
                <p class="text-end">
                    <a href="/Admin/Notification" class="btn btn-primary">Go</a>
                </p>
            </div>
        </div>
        <!--Start card 3-->
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">Add Doctors</h5>
                <p class="card-text text-center">
                    <!--Icons-->
                    <i class="bi bi-person-fill-add fs-1"></i>
                </p>
                <p class="text-end">
                    <a href="/Admin/AddDoctors" class="btn btn-primary">Go</a>
                </p>
            </div>
        </div>

        <!--Start card 4-->
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">Manage Enquiry</h5>
                <p class="card-text text-center">
                    <!--Icons-->
                    <i class="bi bi-patch-question-fill fs-1"></i>
                </p>
                <p class="text-end">
                    <a href="/Admin/ManageEnquiry" class="btn btn-primary">Go</a>
                </p>
            </div>
        </div>
    </div>
</div>>