
@{
    ViewBag.Title = "ManageDoctors";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}
@using HealthCare_ProtoType.Models
@model List<doctormaster>

        <h1 class="text-center bg-danger text-light">Doctor List</h1>
<div class="row p-5" style="min-height:400px;">
    @*<div class="col-sm-10">*@

    <div class="card">
        <div class="table-responsive">
            <table class="table-striped table-hover table">
                <thead class="table-success">
                    <tr>
                        <th>S.N.</th>
                        <th>Doctor Name</th>
                        <th>Specialization</th>
                        <th>Experience</th>
                        <th>AddedOn</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sn = 1;
                    }

                    @foreach (doctormaster item in Model)
                    {
                        <tr>
                            <td>@sn</td>
                            <td>@item.DoctorName</td>
                            <td>@item.Specialization</td>
                            <td>@item.Experience</td>
                            <td>@item.AddedOn</td>
                            <td>
                                <a href="/Admin/UpdateDoctors?id=@item.DocterId" class="btn btn-primary btn-sm">
                                    <i class="bi bi-pen"></i> Update
                                </a>

                                <a href="/Admin/DeleteDoctors?id=@item.DocterId" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this doctor?');">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>

                        sn++;
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

