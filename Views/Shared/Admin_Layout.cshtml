                transform: rotate(270deg);
            }*/
        .text-hover {
            transform: scale(1.05);
            transition: 0.3s;
        }

        </style>
</head>
<body>
    <div class="container-fluid">
        <!--Contact Section Start-->
        @*<div class="row bg-warning text-center py-1">
            <div class="col-sm-6">
                <span class="fw-bold fs-6"><i class="bi bi-telephone-inbound"></i>  Emergency : +91 108</span>
            </div>
            <div class="col-sm-6">
                <span class="fw-bold fs-6"><i class="bi bi-envelope-paper-heart text-danger"></i> HealthCare24X7@gmail.com</span>
            </div>
        </div>*@
        <!--Contact Section end-->
        <!--Header Section Start-->
        <div class="row">
            <div class="col-sm-2 bg-dark  text-light text-center">
                <img src="~/Content/Images/logo.png" style="height: 100px; width: 80%;" />
            </div>
            <div class="col-sm-10 bg-info text-light text-center py-4"><h1 class="fw-bold">Admin Zone (HealthCare)</h1></div>
        </div>
        <!--Header Section end-->
        <!--Navbar Section Start-->
        <div class="row">
            <nav class="navbar navbar-expand-lg bg-body-tertiary shadow">
                <div class="container-fluid">
                    <a class="navbar-brand fw-bold">AdminZone</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto gap-5">
                            <li class="nav-item">
                                <a class="nav-link active" aria-current="page" href="/Admin/Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/ManageNotification">Notification</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/ManageDoctors">Doctors</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/ManageEnquiry">Manage Enquiry</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
        <!--Navbar Section end-->
        <!--Content Section Start-->
        <div class="row m-4" style="min-height:450px;">
            @RenderBody()
        </div>
        <!--Content Section end-->
        <!--Footer Section Start-->
        <div class="row bg-dark text-center text-light px-4">
            <div class="col-sm-1"></div>
            <div class=" col-sm-3 p-4">
                @*<h3>About Us</h3><hr />
                <p style="text-align:justify">
                    The About Us page provides information about the healthcare organization including its mission,
                    vision, and objectives.
                </p>*@
            </div>
            <div class="col-sm-3 py-4 px-5">
                <h3>Important Links</h3><hr />
                <ul type="none" class="p-0">
                    <li><a href="#" class="text-decoration-none text-light">Home</a> </li>
                    <li><a href="#" class="text-decoration-none text-light">Notification</a> </li>
                    <li><a href="#" class="text-decoration-none text-light">Doctors</a> </li>
                    <li><a href="#" class="text-decoration-none text-light">Manage Enquiry</a> </li>
                </ul>

            </div>
            <div class="col-sm-4 p-4">
                @*<h3>Follow Links</h3><hr />
                <p class="d-flex gap-4">
                    <a href="" class="text-decoration-none text-danger"><i class="bi bi-instagram"></i></a>
                    <a href="" class="text-decoration-none text-primary"><i class="bi bi-facebook"></i></a>
                    <a href="" class="text-decoration-none text-light"><i class="bi bi-twitter-x"></i></a>
                    <a href="" class="text-decoration-none text-danger"><i class="bi bi-youtube"></i></a>
                </p>*@
            </div>
            <div class="1"></div><hr />
            <div class="col-sm-12">
                <p>&copy; Copyrights HealthCare Varanasi &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <a href="/General/DeverloperTeam" class="text-decoration-none">Developed By Team S.E.V.E.N.</a></p>
            </div>
        </div>
        <!--Footer Section end-->
    </div>
