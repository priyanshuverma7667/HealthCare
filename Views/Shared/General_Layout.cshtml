
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>General_Layout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="~/Content/CSS/CommonDesign.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>
    @*<style>
        .enquiry-btn {
            position: fixed;
            left: -21px;
            top: 400px;
            transform: rotate(270deg);
        }
    </style>*@
</head>
<body>
    <div class="container-fluid">
        <!--Contact Section Start-->
        <div class="row bg-warning text-center py-1">
            <div class="col-sm-6">
                <span class="fw-bold fs-6"><i class="bi bi-telephone-inbound"></i>  Emergency : +91 108</span>
            </div>
            <div class="col-sm-6">
                <span class="fw-bold fs-6"><i class="bi bi-envelope-paper-heart text-danger"></i> HealthCare24X7@gmail.com</span>
            </div>
        </div>
        <!--Contact Section end-->
        <!--Header Section Start-->
        <div class="row">
            <div class="col-sm-2 bg-dark  text-light text-center">
                <img src="~/Content/Images/logo.png" style="height: 100px; width: 80%;" />
            </div>
            <div class="col-sm-10 bg-info text-light text-center py-4"><h1 class="fw-bold">HealthCare</h1></div>
        </div>
        <!--Header Section end-->
        <!--Navbar Section Start-->
        <div class="row">
            <nav class="navbar navbar-expand-lg bg-body-tertiary shadow">
                <div class="container-fluid">
                    <a class="navbar-brand fw-bold">HealthCare</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto gap-5">
                            <li class="nav-item">
                                <a class="nav-link active" aria-current="page" href="/General/Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/General/AboutUs">About Us</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/General/Doctors">Doctors</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/General/ContactUs">Contact Us</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
        <!--Navbar Section end-->
        <!--Content Section Start-->
        <div class="row pb-4" style="min-height:450px;">
            @RenderBody()
        </div>
        <!--Content Section end-->
        <!--Footer Section Start-->
        <div class="row bg-dark text-center text-light px-4">
            <div class="col-sm-1"></div>
            <div class=" col-sm-3 p-4">
                <h3>About Us</h3><hr />
                <p style="text-align:justify">
                    The About Us page provides information about the healthcare organization including its mission,
                    vision, and objectives.
                </p>
            </div>
            <div class="col-sm-3 py-4 px-5">
                <h3>Important Links</h3><hr />
                <ul type="none" class="p-0">
                    <li><a href="#" class="text-decoration-none text-light">Home</a> </li>
                    <li><a href="#" class="text-decoration-none text-light">About</a> </li>
                    <li><a href="#" class="text-decoration-none text-light">Services</a> </li>
                    <li><a href="#" class="text-decoration-none text-light">Contact</a> </li>
                </ul>

            </div>
            <div class="col-sm-4 p-4">
                <h3>Follow Links</h3><hr />
                <p class="d-flex gap-4">
                    <a href="" class="text-decoration-none text-danger"><i class="bi bi-instagram"></i></a>
                    <a href="" class="text-decoration-none text-primary"><i class="bi bi-facebook"></i></a>
                    <a href="" class="text-decoration-none text-light"><i class="bi bi-twitter-x"></i></a>
                    <a href="" class="text-decoration-none text-danger"><i class="bi bi-youtube"></i></a>
                </p>
            </div>
            <div class="1"></div><hr />
            <div class="col-sm-12">
                <p>&copy; Copyrights HealthCare Varanasi &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <a href="/General/DeverloperTeam" class="text-decoration-none text-warning text-hover">Developed By Team S.E.V.E.N.</a></p>
            </div>
        </div>
        <!--Footer Section end-->


        @*start modal*@

        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary enquiry-btn" data-bs-toggle="modal" data-bs-target="#exampleModal">
            Enquiry
        </button>

        <!-- Modal -->
        <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="exampleModalLabel"  style="z-index: 2;">Enquiry Us</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/General/SaveEnquiry" method="post">
                        <div class="modal-body">
                            <!--Name-->
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="floatingName" placeholder="Name" name="Name">
                                <label for="floatingName"><i class="bi bi-person-fill"></i>Name</label>
                            </div>
                            <!--Email-->
                            <div class="form-floating mb-3">
                                <input type="email" class="form-control" id="floatingEamil" placeholder="Email" name="Email">
                                <label for="floatingName"><i class="bi bi-person-fill"></i>Eamil</label>
                            </div>


                            <!--Mobile Number-->
                            <div class="form-floating mb-3">
                                <input type="number" class="form-control" id="floatingNumber" placeholder="Mobile Number" name="Mobile">
                                <label for="floatingNumber"><i class="bi bi-person-fill"></i>Mobile Number</label>
                            </div>
                            <!--subject-->
                            <!--<div class="form-floating mb-3">
                                <input type="text" class="form-control" id="floatingName" placeholder="Subject">
                                <label for="floatingEmail"><i class="bi bi-person-fill"></i>Subject</label>
                            </div>-->
                            <!--message-->
                            <div class="form-floating mb-3">
                                <textarea class="form-control" id="floatingMessage" placeholder="Message" name="Message"></textarea>
                                <label for="floatingMessage"><i class="bi bi-person-fill"></i> Message</label>
                            </div>

                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Send Enquiry</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @*modal end*@
    </div>
</body>
</html>
