
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/General_Layout.cshtml";
}
@using HealthCare_ProtoType.Models
@model List<notificationmaster>

@*<h2 class="text-center p-4">Home Page</h2>*@

<div class="container-fluid">
    <!--Notification section-->
    <div class="row noti">
        <div class="col-sm-12  text-danger">
            <marquee scrollamount="10" onmouseover="stop()" onmouseleave="start()">
               @{
                   foreach(notificationmaster notice in Model)
            {
                <i class="bi bi-bell-fill"></i>
                <span>@notice.Message</span>
            }
               }
            </marquee>
        </div>
    </div>
    <!--Notification end section-->
    <!--Slider section-->

    <div class="row sli">
        <div class="col-sm-12">
            <div id="carouselExampleCaptions" class="carousel slide">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="3" aria-label="Slide 4"></button>
                    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="4" aria-label="Slide 5"></button>
                    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="5" aria-label="Slide 5"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="~/Content/Images/Hos2.jpg" class="d-block w-100" alt="..." style="height: 600px; width:300px;">
                        <div class="carousel-caption d-none d-md-block">
                            <h5>First slide label</h5>
                            <p>Some representative placeholder content for the first slide.</p>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="~/Content/Images/Hos1.jpg" class="d-block w-100" alt="..." style="height: 600px; width:300px;">
                        <div class="carousel-caption d-none d-md-block">
                            <h5>Second slide label</h5>
                            <p>Some representative placeholder content for the second slide.</p>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="~/Content/Images/Hos3.jpg" class="d-block w-100" alt="..." style="height: 600px; width:300px;">
                        <div class="carousel-caption d-none d-md-block">
                            <h5>Third slide label</h5>
                            <p>Some representative placeholder content for the third slide.</p>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="~/Content/Images/Hos4.jpg" class="d-block w-100" alt="..." style="height: 600px; width:300px;">
                        <div class="carousel-caption d-none d-md-block">
                            <h5>Third slide label</h5>
                            <p>Some representative placeholder content for the third slide.</p>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="~/Content/Images/Hos5.jpg" class="d-block w-100" alt="..." style="height: 600px; width:300px;">
                        <div class="carousel-caption d-none d-md-block">
                            <h5>Third slide label</h5>
                            <p>Some representative placeholder content for the third slide.</p>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="~/Content/Images/Hos6.jpg" class="d-block w-100" alt="..." style="height: 600px; width:300px;">
                        <div class="carousel-caption d-none d-md-block">
                            <h5>Third slide label</h5>
                            <p>Some representative placeholder content for the third slide.</p>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </div>
    <!--Slider end section-->
    <!--Main Section STart -->
    <div class="row my-4">
        <div class="col-sm-1"></div>
        <div class="col-sm-10">
            <h3 class="bg-secondary bg-center text-light text-center p-4">Welcome to Our S.E.V.E.N. Healthcare </h3>
            <p>
                Our Healthcare Management System is designed to provide efficient, reliable, and technology-driven medical services to patients and healthcare providers. This platform helps patients easily access healthcare facilities by allowing them to book appointments with doctors online, view and manage their medical reports, receive important health notifications, and stay updated about their treatment and consultation schedules. The system is developed to simplify the overall healthcare process by reducing paperwork, minimizing waiting time, and improving communication between patients and medical professionals. It also enables hospitals and healthcare organizations to maintain patient records, appointment details, and medical information in a secure and well-organized digital format, ensuring accuracy and easy accessibility whenever required. By integrating modern web technologies, the system aims to create a smooth and user-friendly experience for both patients and healthcare staff. Our objective is to enhance the quality of healthcare services by providing a reliable digital platform where patients can quickly connect with doctors, access healthcare information, and manage their medical history conveniently. At S.E.V.E.N. Healthcare, we believe that technology plays a vital role in transforming traditional healthcare systems into smarter, faster, and more efficient services, helping people receive timely medical care and better health support anytime and anywhere.
            </p>
            <h4>Our Mission</h4>
            <p>
                Our mission is to improve the quality and accessibility of healthcare services by effectively using modern technology and digital solutions. We aim to create a reliable and user-friendly healthcare management platform that helps patients easily connect with doctors, book appointments, access their medical reports, and receive timely health-related notifications. Through this system, we strive to reduce waiting time, improve communication between patients and healthcare providers, and ensure that important medical information is managed in a secure and organized way. Our goal is to support hospitals and medical staff with efficient tools that simplify patient record management and healthcare services, while also providing patients with quick and convenient access to medical assistance whenever they need it. By combining healthcare with innovative technology, we are committed to building a smarter, faster, and more accessible healthcare environment for everyone.
            </p>
        </div>
        <div class="col-sm-1"></div>
    </div>
    <!--Main Section End -->
    <!-- Service Section Start-->
    <h1 class="text-center bg-warning text-light p-4 m-3">Services We Provide</h1>
