
@{
    ViewBag.Title = "AboutUs";
    Layout = "~/Views/Shared/General_Layout.cshtml";
}

<div class="container mt-5">

    <h2 class="text-center mb-4">About Our Healthcare Portal</h2>

    <div class="row">

        <!-- About Portal -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-hospital fs-1 text-danger"></i>
                    <h5 class="card-title mt-3">Our Portal</h5>
                    <p class="card-text">
                        Our Healthcare Portal is designed to provide easy access to
                        health related information, medical services, and online
                        support for patients. It helps users stay informed and
                        manage their health in a better way.
                    </p>
                </div>
            </div>
        </div>

        <!-- Our Mission -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-heart-pulse fs-1 text-success"></i>
                    <h5 class="card-title mt-3">Our Mission</h5>
                    <p class="card-text">
                        Our mission is to improve healthcare accessibility by
                        connecting patients with important medical information
                        and services. We aim to make healthcare simple,
                        reliable, and available for everyone.
                    </p>
                </div>
            </div>
        </div>

        <!-- Our Services -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-clipboard2-pulse fs-1 text-primary"></i>
                    <h5 class="card-title mt-3">Our Services</h5>
                    <p class="card-text">
                        Through this portal users can view health tips,
                        important notifications, healthcare resources,
                        and information related to medical support
                        and public health awareness.
                    </p>
                </div>
            </div>
        </div>

        <div class="container mt-4">

            <div class="row text-center">

                <!-- Health Awareness -->
                <div class="col-md-4 mb-4">
                    <div class="card shadow h-100 border-0">
                        <div class="card-body">
                            <i class="bi bi-lightbulb fs-1 text-warning"></i>
                            <h5 class="card-title mt-3">Health Awareness</h5>
                            <p class="card-text">
                                Our portal spreads awareness about healthy lifestyles,
                                disease prevention, and proper healthcare practices.
                                Users can learn useful health tips to stay fit and safe.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Patient Support -->
                <div class="col-md-4 mb-4">
                    <div class="card shadow h-100 border-0">
                        <div class="card-body">
                            <i class="bi bi-people fs-1 text-primary"></i>
                            <h5 class="card-title mt-3">Patient Support</h5>
                            <p class="card-text">
                                The Healthcare Portal is built to support patients by
                                providing reliable medical information and updates.
                                It helps users easily understand healthcare resources.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Trusted Information -->
                <div class="col-md-4 mb-4">
                    <div class="card shadow h-100 border-0">
                        <div class="card-body">
                            <i class="bi bi-shield-check fs-1 text-success"></i>
                            <h5 class="card-title mt-3">Trusted Information</h5>
                            <p class="card-text">
                                We aim to provide trusted healthcare information that
                                helps users make better health decisions. The portal
                                shares useful guidance related to health and wellness.
                            </p>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>
